# Finovate Audit Nexus AI - Environment Configuration
# Copy this file to .env and update the values

# Application
APP_NAME="Finovate Audit Nexus AI"
APP_ENV=development
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./finovate_audit.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/finovate_audit

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Local AI (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=llama3.2

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# File Storage
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
REPORTS_DIR=./reports

# OCR Settings
OCR_LANGUAGE=ara+eng
OCR_ENGINE=paddleocr  # or tesseract

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/finovate.log

# Security
ENCRYPTION_KEY=your-32-character-encryption-key-here
MFA_ENABLED=False
SESSION_TIMEOUT_MINUTES=60
