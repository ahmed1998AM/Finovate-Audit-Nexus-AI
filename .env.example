# Finovate Audit Nexus AI - Environment Configuration
# Copy this file to .env and update with your settings

# Application
APP_NAME="Finovate Audit Nexus AI"
APP_VERSION="1.0.0"
APP_ENV="development"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/finovate_audit"
SQLITE_DB_PATH="database/finovate.db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# AI Providers - Add your API keys here
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
DEEPSEEK_API_KEY=""
MISTRAL_API_KEY=""
XAI_API_KEY=""
COHERE_API_KEY=""

# Local AI (Ollama)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Security
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption
ENCRYPTION_KEY="your-encryption-key-32-chars-long!"

# API
API_HOST="0.0.0.0"
API_PORT=8000
API_DEBUG=true

# Logging
LOG_LEVEL="INFO"
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_MB=10

# UI
DEFAULT_THEME="dark_professional"

# ERP Connectors
SAP_ENABLED=false
ORACLE_ENABLED=false
DYNAMICS_ENABLED=false
ODOO_ENABLED=false
ZOHO_ENABLED=false
QUICKBOOKS_ENABLED=false
XERO_ENABLED=false

# Compliance
EGYPTIAN_STANDARDS_ENABLED=true
IFRS_ENABLED=true
ISA_ENABLED=true

# Tax
VAT_RATE=14.0
