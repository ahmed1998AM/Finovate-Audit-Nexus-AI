# Finovate Audit Nexus AI - Environment Configuration
# Copy this file to .env and fill in your values

# ---- Security ----
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string
ENCRYPTION_KEY=change-this-to-a-32-char-key-for-AES!

# ---- Database ----
# SQLite (development)
DATABASE_URL=sqlite:///./finovate_audit.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@host:5432/finovate_audit

# ---- API Configuration ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ---- AI Providers ----
# Set at least one provider key for AI features
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
# Ollama runs locally (no API key required)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- LLM Fallback Chain ----
# Comma-separated list of providers to try if the primary fails
FALLBACK_LLM_PROVIDERS=anthropic,gemini,groq,ollama

# ---- ERP Connectors ----
SAP_JCO_HOST=
SAP_JCO_CLIENT=800
SAP_JCO_USER=
SAP_JCO_PASSWD=
ORACLE_DB_HOST=
ORACLE_DB_PORT=1521
ORACLE_DB_USER=
ORACLE_DB_PASSWORD=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
EBS_DB_HOST=
EBS_DB_PORT=1521
EBS_DB_USER=
EBS_DB_PASSWORD=
INFOR_SERVICE_URL=
INFOR_API_KEY=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=

# ---- Monitoring ----
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=false

# ---- Database Backup ----
# Directory for database backups (default: ./backups)
BACKUP_DIR=./backups
# Maximum number of backups to retain (default: 10)
MAX_BACKUPS=10
# KDF salt for encryption key derivation (set once, never change after)
# If not set, it is derived from ENCRYPTION_KEY automatically
# KDF_SALT=

# ---- Redis (for task queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- Vector Database (Qdrant) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Celery (async task queue) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- SMTP / Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@finovate.ai
SMTP_FROM_NAME=Finovate Audit Nexus
SMTP_USE_TLS=true

# ---- TLS / HTTPS ----
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=

# ---- i18n / Localization ----
DEFAULT_LANG=ar
APP_URL=http://localhost:8000
