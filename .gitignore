```gitignore
# Python compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Test cache
.pytest_cache/
.coverage
coverage/
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Environment files
.env
.env.local
*.env.*

# OS generated files
.DS_Store
Thumbs.db

# Build outputs
dist/
build/
target/
```