```gitignore
# Python compiled files
*.pyc
__pycache__/

# Excel export files
exports/*.xlsx

# Logs and temporary files
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# System files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/
```